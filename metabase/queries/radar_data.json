[
  {
    "$addFields": {
      "dateObj": {
        "$cond": [
          { "$eq": [{ "$type": "$date_signalement" }, "date"] },
          "$date_signalement",
          { "$dateFromString": { "dateString": "$date_signalement", "onError": null } }
        ]
      }
    }
  },
  {
    "$project": {
      "mois": { "$month": "$dateObj" },
      "probleme": { "$ifNull": ["$categorie_label_fr", "$categorie"] }
    }
  },
  {
    "$group": {
      "_id": {
        "mois": "$mois",
        "probleme": "$probleme"
      },
      "total": { "$sum": 1 }
    }
  },
  {
    "$project": {
      "_id": 0,
      "mois": "$_id.mois",
      "probleme": "$_id.probleme",
      "count": "$total"
    }
  },
  {
    "$sort": { "mois": 1, "count": -1 }
  }
]
