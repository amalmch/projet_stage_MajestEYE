[
  {
    "$addFields": {
      "dateObj": {
        "$cond": [
          { "$eq": [{ "$type": "$date_signalement" }, "date"] },
          "$date_signalement",
          { "$dateFromString": { "dateString": "$date_signalement", "onError": null } }
        ]
      }
    }
  },
  {
    "$addFields": {
      "month": { "$month": "$dateObj" }
    }
  },
  {
    "$addFields": {
      "saison": {
        "$switch": {
          "branches": [
            { "case": { "$in": ["$month", [12, 1, 2]] }, "then": "Hiver" },
            { "case": { "$in": ["$month", [3, 4, 5]] }, "then": "Printemps" },
            { "case": { "$in": ["$month", [6, 7, 8]] }, "then": "Été" },
            { "case": { "$in": ["$month", [9, 10, 11]] }, "then": "Automne" }
          ],
          "default": "Inconnue"
        }
      }
    }
  },
  {
    "$group": {
      "_id": {
        "saison": "$saison",
        "type": { "$ifNull": ["$categorie_label_fr", "$categorie"] }
      },
      "total": { "$sum": 1 }
    }
  },
  {
    "$project": {
      "_id": 0,
      "saison": "$_id.saison",
      "type_reclamation": "$_id.type",
      "nb_reclamations": "$total"
    }
  },
  {
    "$sort": { "saison": 1, "nb_reclamations": -1 }
  }
]
