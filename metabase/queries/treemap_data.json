[
  {
    "$group": {
      "_id": {
        "gouvernorat": "$gouvernorat",
        "categorie": { "$ifNull": ["$categorie_label_fr", "$categorie"] },
        "urgence": "$urgence"
      },
      "value": { "$sum": 1 }
    }
  },
  {
    "$project": {
      "_id": 0,
      "gouvernorat": "$_id.gouvernorat",
      "categorie": "$_id.categorie",
      "urgence": "$_id.urgence",
      "count": "$value"
    }
  },
  {
    "$sort": { "count": -1 }
  }
]
